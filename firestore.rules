
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // 1. AUTENTICAÇÃO E AUTORIZAÇÃO
    // ==========================================

    function logado() {
      return request.auth != null;
    }

    function dono(uid) {
      return logado()
        && request.auth.uid == uid;
    }

    function admin() {
      return logado()
        && exists(
          /databases/$(database)/documents/administradores/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/administradores/$(request.auth.uid)
        ).data.ativo == true;
    }

    function caminhoItem(itemId) {
      return /databases/$(database)/documents/itens/$(itemId);
    }

    function caminhoPedido(pedidoId) {
      return /databases/$(database)/documents/solicitacoesDevolucao/$(pedidoId);
    }

    function caminhoCodigo(pedidoId) {
      return /databases/$(database)/documents/codigosRetirada/$(pedidoId);
    }

    function caminhoConferencia(pedidoId) {
      return /databases/$(database)/documents/conferenciasRetirada/$(pedidoId);
    }

    function codigoValido(codigo) {
      return codigo is string
        && codigo.matches('^[A-HJ-NP-Z2-9]{3}-[A-HJ-NP-Z2-9]{3}$');
    }

    function caminhoUsuario(uid) {
      return /databases/$(database)/documents/usuarios/$(uid);
    }

    function caminhoMatricula(numero) {
      return /databases/$(database)/documents/matriculas/$(numero);
    }

    // ==========================================
    // 2. ADMINISTRADORES
    // ==========================================

    match /administradores/{uid} {

      // Consulta somente da própria autorização.
      allow get: if dono(uid) || admin();

      allow list: if false;

      // A promoção exige um administrador ativo e a alteração
      // simultânea do perfil correspondente no mesmo batch.
      allow create: if admin()
        && request.auth.uid != uid
        && exists(caminhoUsuario(uid))
        && get(caminhoUsuario(uid)).data.get('eAdmin', false) == false
        && get(caminhoUsuario(uid)).data.get('tipo', 'usuario') == 'usuario'
        && request.resource.data.keys().hasOnly([
          'ativo', 'concedidoPor', 'dataConcessao'
        ])
        && request.resource.data.keys().hasAll([
          'ativo', 'concedidoPor', 'dataConcessao'
        ])
        && request.resource.data.ativo == true
        && request.resource.data.concedidoPor == request.auth.uid
        && request.resource.data.dataConcessao == request.time
        && getAfter(caminhoUsuario(uid)).data.tipo == 'admin'
        && getAfter(caminhoUsuario(uid)).data.eAdmin == true;

      // Revogação: desativa autorização e rebaixa perfil no mesmo batch.
      // Reativação: exige o movimento inverso, também atômico.
      allow update: if admin()
        && request.auth.uid != uid
        && exists(caminhoUsuario(uid))
        && (
          (
            resource.data.ativo == true
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['ativo', 'revogadoPor', 'dataRevogacao'])
            && request.resource.data.ativo == false
            && request.resource.data.revogadoPor == request.auth.uid
            && request.resource.data.dataRevogacao == request.time
            && get(caminhoUsuario(uid)).data.tipo == 'admin'
            && get(caminhoUsuario(uid)).data.eAdmin == true
            && getAfter(caminhoUsuario(uid)).data.tipo == 'usuario'
            && getAfter(caminhoUsuario(uid)).data.eAdmin == false
          )
          ||
          (
            resource.data.ativo == false
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['ativo', 'concedidoPor', 'dataConcessao', 'revogadoPor', 'dataRevogacao'])
            && request.resource.data.ativo == true
            && request.resource.data.concedidoPor == request.auth.uid
            && request.resource.data.dataConcessao == request.time
            && !('revogadoPor' in request.resource.data)
            && !('dataRevogacao' in request.resource.data)
            && get(caminhoUsuario(uid)).data.tipo == 'usuario'
            && get(caminhoUsuario(uid)).data.eAdmin == false
            && getAfter(caminhoUsuario(uid)).data.tipo == 'admin'
            && getAfter(caminhoUsuario(uid)).data.eAdmin == true
          )
        );

      allow delete: if false;
    }

    // ==========================================
    // 3. USUÁRIOS
    // ==========================================

    match /usuarios/{uid} {

      // Estudantes consultam o próprio perfil.
      // Administradores podem consultar perfis.
      allow get: if dono(uid) || admin();

      allow list: if admin();

      // Matrícula padronizada:
      // 4 a 20 dígitos, sem zero inicial.
      function matriculaValida(numero) {
        return numero is string
          && numero.matches('^[1-9][0-9]{3,19}$');
      }

      // Confere a correspondência entre
      // matrícula reservada e perfil.
      function reservaCorreta(numero) {
        return matriculaValida(numero)
          && getAfter(
            caminhoMatricula(numero)
          ).data.uid == uid;
      }

      // --------------------------------------
      // CRIAR PERFIL
      // --------------------------------------

      allow create: if dono(uid)

        && request.resource.data.keys().hasOnly([
          'nome',
          'email',
          'numeroCadastro',
          'tipo',
          'eAdmin',
          'dataCriacao'
        ])

        && request.resource.data.keys().hasAll([
          'nome',
          'email',
          'numeroCadastro',
          'tipo',
          'eAdmin'
        ])

        && request.resource.data.nome is string

        && request.resource.data.nome.size() > 0

        && request.resource.data.nome.size() <= 160

        && request.resource.data.email ==
          request.auth.token.email

        && request.resource.data.tipo == 'usuario'

        && request.resource.data.eAdmin == false

        && reservaCorreta(
          request.resource.data.numeroCadastro
        );

      // --------------------------------------
      // EDITAR DADOS PESSOAIS
      // --------------------------------------

      function editarDadosPessoais() {
        return dono(uid)

          // Somente nome e e-mail podem mudar.
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly([
              'nome',
              'email'
            ])

          && request.resource.data.nome is string

          && request.resource.data.nome.size() > 0

          && request.resource.data.nome.size() <= 160

          && request.resource.data.email ==
            request.auth.token.email;
      }

      // --------------------------------------
      // COMPLETAR PERFIL ANTIGO
      // --------------------------------------

      function completarPerfilAntigo() {
        return dono(uid)

          // Somente perfis ainda sem matrícula.
          && resource.data.get(
            'numeroCadastro',
            ''
          ) == ''

          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly([
              'nome',
              'numeroCadastro'
            ])

          && request.resource.data.nome is string

          && request.resource.data.nome.size() > 0

          && request.resource.data.nome.size() <= 160

          && reservaCorreta(
            request.resource.data.numeroCadastro
          );
      }

      // A promoção atualiza apenas tipo/eAdmin e exige
      // a criação da autorização no mesmo batch.
      function promoverPerfil() {
        return admin()
          && request.auth.uid != uid
          && resource.data.get('tipo', 'usuario') == 'usuario'
          && resource.data.get('eAdmin', false) == false
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['tipo', 'eAdmin'])
          && request.resource.data.tipo == 'admin'
          && request.resource.data.eAdmin == true
          && (!exists(/databases/$(database)/documents/administradores/$(uid))
              || get(/databases/$(database)/documents/administradores/$(uid)).data.ativo == false)
          && getAfter(/databases/$(database)/documents/administradores/$(uid)).data.ativo == true
          && getAfter(/databases/$(database)/documents/administradores/$(uid)).data.concedidoPor == request.auth.uid
          && getAfter(/databases/$(database)/documents/administradores/$(uid)).data.dataConcessao == request.time;
      }

      function revogarPerfil() {
        return admin()
          && request.auth.uid != uid
          && resource.data.tipo == 'admin'
          && resource.data.eAdmin == true
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['tipo', 'eAdmin'])
          && request.resource.data.tipo == 'usuario'
          && request.resource.data.eAdmin == false
          && exists(/databases/$(database)/documents/administradores/$(uid))
          && get(/databases/$(database)/documents/administradores/$(uid)).data.ativo == true
          && getAfter(/databases/$(database)/documents/administradores/$(uid)).data.ativo == false
          && getAfter(/databases/$(database)/documents/administradores/$(uid)).data.revogadoPor == request.auth.uid
          && getAfter(/databases/$(database)/documents/administradores/$(uid)).data.dataRevogacao == request.time;
      }

      allow update: if editarDadosPessoais()
        || completarPerfilAntigo()
        || promoverPerfil()
        || revogarPerfil();

      // Não apagar o perfil diretamente.
      allow delete: if false;
    }

    // ==========================================
    // 4. MATRÍCULAS
    // ==========================================

    match /matriculas/{numero} {

      // Somente o próprio estudante pode consultar
      // o documento da sua matrícula.
      //
      // Um estudante não pode descobrir
      // o UID associado à matrícula de outra conta.
      allow get: if logado()
        && resource != null
        && resource.data.uid == request.auth.uid;

      // Impede listar todas as matrículas.
      allow list: if false;

      // Formato padronizado da matrícula.
      function numeroValido() {
        return numero.matches('^[1-9][0-9]{3,19}$');
      }

      // Confere o perfil após a transação.
      function perfilCorrespondente() {
        return getAfter(
          caminhoUsuario(request.auth.uid)
        ).data.numeroCadastro == numero;
      }

      // --------------------------------------
      // RESERVAR MATRÍCULA
      // --------------------------------------

      // A criação de matrícula exige:
      // - usuário autenticado;
      // - matrícula no formato correto;
      // - UID do próprio estudante;
      // - data criada pelo servidor;
      // - perfil correspondente na transação.

      allow create: if logado()

        && numeroValido()

        && request.resource.data.keys().hasOnly([
          'uid',
          'criadoEm'
        ])

        && request.resource.data.keys().hasAll([
          'uid',
          'criadoEm'
        ])

        && request.resource.data.uid ==
          request.auth.uid

        && request.resource.data.criadoEm ==
          request.time

        && perfilCorrespondente();

      // Matrículas existentes não podem
      // ser alteradas, transferidas ou apagadas.
      allow update, delete: if false;
    }

    // ==========================================
    // 5. ITENS
    // ==========================================

    match /itens/{itemId} {

      // O catálogo é público.
      allow read: if true;

      // --------------------------------------
      // CADASTRO ADMINISTRATIVO
      // --------------------------------------

      allow create: if admin()

        && request.resource.data.keys().hasAll([
          'titulo',
          'status',
          'teveSolicitacoes'
        ])

        && request.resource.data.titulo is string

        && request.resource.data.titulo.size() > 0

        && request.resource.data.status ==
          'disponível'

        // Todo novo item começa sem histórico.
        && request.resource.data.teveSolicitacoes == false

        && (
          !('solicitacaoAtivaId' in request.resource.data)
          || request.resource.data.solicitacaoAtivaId == null
        );

      // --------------------------------------
      // EDIÇÃO ADMINISTRATIVA
      // --------------------------------------

      function editarDadosItem() {
        return admin()

          // Apenas campos cadastrais.
          // Protege status, reserva e histórico.
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly([
              'titulo',
              'descricao',
              'categoriaId',
              'localEncontrado',
              'fotoUrl'
            ])

          && request.resource.data.titulo is string

          && request.resource.data.titulo.size() > 0

          && request.resource.data.titulo.size() <= 160

          && request.resource.data.descricao is string

          && request.resource.data.descricao.size() <= 3000

          && request.resource.data.categoriaId is string

          && request.resource.data.localEncontrado is string

          // Imagens em Base64 armazenadas
          // diretamente no Firestore.
          && request.resource.data.get(
            'fotoUrl',
            ''
          ) is string

          && request.resource.data.get(
            'fotoUrl',
            ''
          ).size() <= 600000;
      }

      // Reserva criada pelo aluno em transação atômica.
      function reservarItem() {
        let pedidoId = request.resource.data.solicitacaoAtivaId;
        return logado() && !admin()
          && resource.data.status == 'disponível'
          && resource.data.get('solicitacaoAtivaId', null) == null
          && pedidoId is string
          && pedidoId.size() > 0
          && request.resource.data.status == 'em análise'
          && request.resource.data.teveSolicitacoes == true
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'solicitacaoAtivaId', 'teveSolicitacoes'])
          && !exists(caminhoPedido(pedidoId))
          && getAfter(caminhoPedido(pedidoId)).data.itemId == itemId
          && getAfter(caminhoPedido(pedidoId)).data.usuarioId == request.auth.uid
          && getAfter(caminhoPedido(pedidoId)).data.status == 'Pendente';
      }

      // Cancelamento do aluno ou atendimento do administrador.
      function finalizarReserva() {
        let pedidoId = resource.data.solicitacaoAtivaId;
        return logado()
          && resource.data.status == 'em análise'
          && pedidoId is string
          && request.resource.data.solicitacaoAtivaId == null
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'solicitacaoAtivaId'])
          && get(caminhoPedido(pedidoId)).data.status == 'Pendente'
          && get(caminhoPedido(pedidoId)).data.itemId == itemId
          && (
            (
              request.resource.data.status == 'disponível'
              && get(caminhoPedido(pedidoId)).data.usuarioId == request.auth.uid
              && getAfter(caminhoPedido(pedidoId)).data.status == 'Cancelado'
            ) || (
              admin()
              && getAfter(caminhoPedido(pedidoId)).data.atendidoPor == request.auth.uid
              && (
                (request.resource.data.status == 'devolvido'
                  && getAfter(caminhoPedido(pedidoId)).data.status == 'Concluído')
                || (request.resource.data.status == 'disponível'
                  && getAfter(caminhoPedido(pedidoId)).data.status == 'Recusado')
              )
            )
          );
      }

      // --------------------------------------
      // PERMISSÕES DOS ITENS
      // --------------------------------------

      allow update: if reservarItem()
        || finalizarReserva()
        || editarDadosItem();

      // Somente administradores podem excluir.
      // O item não pode ter reserva ou histórico.
      // Itens antigos sem o campo permanecem protegidos.
      allow delete: if admin()
        && resource.data.status == 'disponível'
        && resource.data.get(
          'solicitacaoAtivaId',
          null
        ) == null
        && resource.data.get(
          'teveSolicitacoes',
          true
        ) == false;
    }

    // ==========================================
    // 6. CATEGORIAS
    // ==========================================

    match /categorias/{id} {

      allow read: if true;

      allow write: if false;
    }

    // ==========================================
    // 7. LOCAIS
    // ==========================================

    match /locais/{id} {

      allow read: if true;

      allow write: if false;
    }

    // ==========================================
    // 8. SOLICITAÇÕES DE DEVOLUÇÃO
    // ==========================================

    match /solicitacoesDevolucao/{pedidoId} {

      // Administradores consultam todas.
      // Estudantes consultam apenas as próprias.
      allow get, list: if admin()
        || (
          logado()
          && resource.data.usuarioId == request.auth.uid
        );

      // O aluno cria o pedido junto da reserva e do código.
      function criarPedido() {
        let itemId = request.resource.data.itemId;
        let perfil = get(caminhoUsuario(request.auth.uid)).data;
        return logado() && !admin()
          && itemId is string
          && request.resource.data.keys().hasOnly([
            'itemId', 'itemTitulo', 'usuarioId', 'nomeUsuario',
            'numeroCadastro', 'status', 'dataSolicitacao'
          ])
          && request.resource.data.keys().hasAll([
            'itemId', 'itemTitulo', 'usuarioId', 'nomeUsuario',
            'numeroCadastro', 'status', 'dataSolicitacao'
          ])
          && request.resource.data.usuarioId == request.auth.uid
          && perfil.get('tipo', 'usuario') == 'usuario'
          && perfil.get('eAdmin', false) == false
          && request.resource.data.nomeUsuario == perfil.nome
          && request.resource.data.numeroCadastro == perfil.numeroCadastro
          && request.resource.data.itemTitulo == get(caminhoItem(itemId)).data.titulo
          && request.resource.data.status == 'Pendente'
          && request.resource.data.dataSolicitacao == request.time
          && get(caminhoItem(itemId)).data.status == 'disponível'
          && get(caminhoItem(itemId)).data.get('solicitacaoAtivaId', null) == null
          && getAfter(caminhoItem(itemId)).data.status == 'em análise'
          && getAfter(caminhoItem(itemId)).data.solicitacaoAtivaId == pedidoId
          && getAfter(caminhoCodigo(pedidoId)).data.usuarioId == request.auth.uid
          && codigoValido(getAfter(caminhoCodigo(pedidoId)).data.codigo);
      }

      allow create: if criarPedido();

      // --------------------------------------
      // CANCELAR SOLICITAÇÃO
      // --------------------------------------

      function cancelarPedido() {
        return logado()

          && resource.data.usuarioId == request.auth.uid

          && resource.data.status == 'Pendente'

          && request.resource.data.status == 'Cancelado'

          && request.resource.data.dataCancelamento ==
            request.time

          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly([
              'status',
              'dataCancelamento'
            ])

          // Confere a reserva original.
          && get(
            caminhoItem(resource.data.itemId)
          ).data.status == 'em análise'

          && get(
            caminhoItem(resource.data.itemId)
          ).data.solicitacaoAtivaId == pedidoId

          // Confere a liberação do item
          // na mesma transação.
          && getAfter(
            caminhoItem(resource.data.itemId)
          ).data.status == 'disponível'

          && getAfter(
            caminhoItem(resource.data.itemId)
          ).data.solicitacaoAtivaId == null;
      }

      function atenderPedido() {
        let itemId = resource.data.itemId;
        return admin()
          && resource.data.status == 'Pendente'
          && request.resource.data.status in ['Concluído', 'Recusado']
          && request.resource.data.atendidoPor == request.auth.uid
          && request.resource.data.dataAtendimento == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'atendidoPor', 'dataAtendimento'])
          && get(caminhoItem(itemId)).data.status == 'em análise'
          && get(caminhoItem(itemId)).data.solicitacaoAtivaId == pedidoId
          && getAfter(caminhoItem(itemId)).data.solicitacaoAtivaId == null
          && (
            (request.resource.data.status == 'Concluído'
              && getAfter(caminhoItem(itemId)).data.status == 'devolvido'
              && getAfter(caminhoConferencia(pedidoId)).data.codigo
                == get(caminhoCodigo(pedidoId)).data.codigo)
            || (request.resource.data.status == 'Recusado'
              && getAfter(caminhoItem(itemId)).data.status == 'disponível')
          );
      }

      allow update: if cancelarPedido() || atenderPedido();
      allow delete: if false;
    }

    // Código legível somente pelo solicitante. Nunca editável.
    match /codigosRetirada/{pedidoId} {
      allow get: if logado() && resource.data.usuarioId == request.auth.uid;
      allow list: if false;
      allow create: if logado() && !admin()
        && request.resource.data.keys().hasOnly(['codigo', 'usuarioId', 'criadoEm'])
        && request.resource.data.keys().hasAll(['codigo', 'usuarioId', 'criadoEm'])
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.criadoEm == request.time
        && codigoValido(request.resource.data.codigo)
        && !exists(caminhoPedido(pedidoId))
        && getAfter(caminhoPedido(pedidoId)).data.usuarioId == request.auth.uid
        && getAfter(caminhoPedido(pedidoId)).data.status == 'Pendente';
      allow update, delete: if false;
    }

    // A administração escreve o código informado pelo aluno sem poder lê-lo.
    // Uma conferência por pedido, criada somente junto da conclusão.
    match /conferenciasRetirada/{pedidoId} {
      allow read: if false;
      allow create: if admin()
        && request.resource.data.keys().hasOnly(['codigo', 'administradorId', 'criadoEm'])
        && request.resource.data.keys().hasAll(['codigo', 'administradorId', 'criadoEm'])
        && request.resource.data.administradorId == request.auth.uid
        && request.resource.data.criadoEm == request.time
        && codigoValido(request.resource.data.codigo)
        && exists(caminhoPedido(pedidoId))
        && get(caminhoPedido(pedidoId)).data.status == 'Pendente'
        && getAfter(caminhoPedido(pedidoId)).data.status == 'Concluído'
        && getAfter(caminhoPedido(pedidoId)).data.atendidoPor == request.auth.uid
        && request.resource.data.codigo == get(caminhoCodigo(pedidoId)).data.codigo;
      allow update, delete: if false;
    }

    // ==========================================
    // 9. BLOQUEIO PADRÃO
    // ==========================================

    match /{document=**} {
      allow read, write: if false;
    }

  }
}
