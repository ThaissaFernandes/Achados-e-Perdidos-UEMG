# Copie este arquivo para ".env" e preencha com os dados do seu projeto Firebase
# (Console do Firebase > Configurações do projeto > Seus apps > Configuração do SDK).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Método de login: "senha" (e-mail e senha, padrão por enquanto) ou "microsoft".
# A regra de matrícula única vale nos dois. Reinicie o servidor depois de mudar.
VITE_METODO_LOGIN=senha

# Simulação (padrão): qualquer conta Microsoft pode entrar. Use "true" para exigir conta da UEMG
# (@discente.uemg.br ou @uemg.br). Reinicie o servidor depois de mudar.
VITE_RESTRINGIR_DOMINIO_UEMG=false

# Opcional: quais contas Microsoft podem entrar. Padrão: "common" na simulação e "organizations" no modo restrito.
# Pode ser o ID do tenant da UEMG. Deixe vazio para usar o padrão.
VITE_MICROSOFT_TENANT=
