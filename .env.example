# Copie este arquivo para ".env" e preencha com os dados do seu projeto Firebase
# (Console do Firebase > Configurações do projeto > Seus apps > Configuração do SDK).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opcional: "true" faz o cadastro aceitar só e-mails da UEMG (@uemg.br ou @discente.uemg.br).
# Por padrão (false ou vazio) qualquer e-mail pode se cadastrar. Reinicie o servidor depois de mudar.
VITE_RESTRINGIR_DOMINIO_UEMG=false

# Firebase App Check reCAPTCHA v3 site key (public key, configure no Console)
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Mostrar aviso de ambiente demonstrativo em publicação do TCC
VITE_AMBIENTE_DEMO=true
